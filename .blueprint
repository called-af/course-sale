created:
    - database/factories/QuizQuestionFactory.php
    - database/factories/QuizOptionFactory.php
    - database/factories/QuizAttemptFactory.php
    - database/factories/QuizAnswerFactory.php
    - database/migrations/2026_02_19_042011_create_quiz_questions_table.php
    - database/migrations/2026_02_19_042012_create_quiz_options_table.php
    - database/migrations/2026_02_19_042013_create_quiz_attempts_table.php
    - database/migrations/2026_02_19_042014_create_quiz_answers_table.php
    - app/Models/QuizQuestion.php
    - app/Models/QuizOption.php
    - app/Models/QuizAttempt.php
    - app/Models/QuizAnswer.php
models:
    Category: { name: string, slug: string }
    Course: { creator_id: 'biginteger unsigned', title: string, slug: string, description: 'text nullable default:NULL', thumbnail: 'string nullable default:NULL', type: "enum:'free','paid' nullable default:NULL", price: 'decimal:10,2 nullable default:NULL', level: "enum:'beginner','intermediate','advanced' nullable default:NULL", status: "enum:'draft','review','published','archived' default:'draft'", published_at: 'timestamp nullable default:NULL', rating_avg: 'decimal:3,2 default:0.00', rating_count: integer }
    CourseCategory: { course_id: 'biginteger unsigned', category_id: 'biginteger unsigned' }
    Enrollment: { user_id: 'biginteger unsigned', course_id: 'biginteger unsigned', status: "enum:'active','revoked','expired' default:'active'", enrolled_at: timestamp }
    Material: { module_id: 'biginteger unsigned', title: string, description: text, sort_order: integer, is_preview: boolean }
    MaterialProgress: { user_id: 'biginteger unsigned', material_id: 'biginteger unsigned', is_completed: boolean, completed_at: 'timestamp nullable default:NULL' }
    Module: { course_id: 'biginteger unsigned', title: string, sort_order: integer }
    Order: { user_id: 'biginteger unsigned', total_price: 'decimal:10,2', status: "enum:'pending','paid','failed','expired'" }
    OrderItem: { order_id: 'biginteger unsigned', course_id: 'biginteger unsigned', course_title: string, course_price: 'decimal:10,2' }
    Payment: { order_id: 'biginteger unsigned', provider_id: 'biginteger unsigned', reference: string, amount: 'decimal:10,2', currency: "string default:'IDR'", status: "enum:'pending','paid','failed','expired','refunded'", payment_url: 'text nullable default:NULL', paid_at: 'timestamp nullable default:NULL' }
    PaymentLog: { payment_id: 'biginteger unsigned', event: string, payload: longtext }
    PaymentMethod: { provider_id: 'biginteger unsigned', name: string, code: string }
    PaymentProvider: { name: string, code: string, is_active: 'boolean default:1' }
    Refund: { payment_id: 'biginteger unsigned', amount: 'decimal:10,2', reason: 'text nullable default:NULL', status: "enum:'pending','success','failed'", refunded_at: 'timestamp nullable default:NULL' }
    Review: { user_id: 'biginteger unsigned', course_id: 'biginteger unsigned', rating: integer, comment: 'text nullable default:NULL' }
    User: { name: string, email: string, password: string, role: "enum:'student','instructor','admin' nullable default:NULL", avatar: 'string nullable default:NULL' }
    QuizQuestion: { material_content_id: 'id foreign:material_contents', question: text, sort_order: integer, timestamps: timestamps }
    QuizOption: { quiz_question_id: 'id foreign:quiz_questions', option_text: string, is_correct: 'boolean default:false', timestamps: timestamps }
    QuizAttempt: { user_id: 'id foreign:users', material_content_id: 'id foreign:material_contents', started_at: timestamp, finished_at: 'timestamp nullable', time_spent: 'integer nullable', score: 'decimal:5,2 nullable', status: 'enum:in_progress,completed,expired', timestamps: timestamps, indexes: [{ index: user_id }, { index: material_content_id }] }
    QuizAnswer: { quiz_attempt_id: 'id foreign:quiz_attempts', quiz_question_id: 'id foreign:quiz_questions', quiz_option_id: 'id foreign:quiz_options nullable', answer_text: 'text nullable', is_correct: 'boolean nullable', timestamps: timestamps, indexes: [{ index: quiz_attempt_id }] }
