APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Production: set APP_ENV=production, APP_DEBUG=false, and APP_URL to your HTTPS domain.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Keep retry_after above the Supervisor worker --timeout (120s).
DB_QUEUE_RETRY_AFTER=150
REDIS_QUEUE_RETRY_AFTER=150

CACHE_STORE=database
# CACHE_PREFIX=

# Retention windows used by `php artisan system:prune-data`.
SESSION_RETENTION_DAYS=14
JOB_BATCH_RETENTION_DAYS=7
OPERATIONAL_LOG_RETENTION_DAYS=90
PAYMENT_LOG_RETENTION_DAYS=365
CHAT_MESSAGE_RETENTION_DAYS=180

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# For higher traffic, set SESSION_DRIVER=redis, CACHE_STORE=redis and
# QUEUE_CONNECTION=redis after installing/configuring Redis.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment gateway (production: midtrans)
PAYMENT_GATEWAY=midtrans
PAYMENT_CURRENCY=IDR
# Persentase fee platform yang dipotong dari pendapatan instruktur.
PLATFORM_FEE_PERCENT=20

# Operasional payout instruktur.
# Dana ditahan sekian hari setelah settlement sebelum bisa dicairkan.
PAYOUT_HOLD_DAYS=7
# Nominal minimum (Rupiah) sebelum payout dikirim ke instruktur.
PAYOUT_MINIMUM=100000
# Rekening yang baru diubah dikunci sekian jam sebelum bisa menerima payout.
PAYOUT_ACCOUNT_LOCK_HOURS=24

# Kebijakan refund course berbayar.
# Refund hanya bisa diajukan dalam sekian hari sejak enrollment.
REFUND_WINDOW_DAYS=7
# Refund ditolak jika progress belajar sudah melewati persentase ini.
REFUND_MAX_PROGRESS_PERCENT=25

# Midtrans — set MIDTRANS_IS_PRODUCTION=true and use the production keys
# when going live. The Snap/API hosts are derived automatically; override only
# if you proxy requests through a custom domain.
MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com
# MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_TIMEOUT=15

# Recommendation Engine Configuration
RECOMMENDATION_ENABLED=true
RECOMMENDATION_CACHE_TTL=7200
# RECOMMENDATION_CACHE_STORE=database

# Demo account seeding password (override in production)
SEEDER_PASSWORD=password

# Contact email shown on marketing pages
CONTACT_EMAIL=hello@example.com

# NVIDIA NIM API Configuration
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama3-70b-instruct

# Google OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# WhatsApp Gateway Configuration (Infobip / Meta)
WHATSAPP_PROVIDER=infobip
INFOBIP_BASE_URL=https://55z3yd.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_FROM=447860088970
INFOBIP_SANDBOX_KEYWORD=ARKADANISAYSSTUFF

# WhatsApp Business Cloud API Configuration (Meta fallback)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=id
